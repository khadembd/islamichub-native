<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_glass_premium.xml — glassmorphic premium card background
    Per source islamic.html CSS: backdrop-filter: blur(20px); rgba(255,255,255,0.72)
    Android can't blur through XML, but we simulate with semi-transparent white
    + subtle stroke + shadow (handled by elevation).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#B8FFFFFF" />
    <corners android:radius="20dp" />
    <stroke android:width="1.5dp" android:color="#4DFFFFFF" />
</shape>
