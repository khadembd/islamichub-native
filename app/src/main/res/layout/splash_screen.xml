<?xml version="1.0" encoding="utf-8"?>
<!--
    splash_screen.xml — premium splash screen layout
    Per source islamic.html #appSplash (lines 2827-2870):
      - Mosque image background
      - Logo (premium-mosque vector) in white rounded box
      - "Islamic Hub" title
      - "Spiritual Knowledge" subtitle
      - Quran quote
      - Loading bar (yellow fill animating)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo in white rounded box -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_splash_logo"
            android:elevation="10dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_app_logo"
                android:src="@drawable/premium_mosque"
                app:tint="@color/primary" />

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:text="Islamic Hub"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.15"
            android:text="SPIRITUAL KNOWLEDGE"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Quran quote -->
        <TextView
            android:id="@+id/splashQuote"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="@font/arabic_font"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp"
            android:textStyle="italic" />

        <!-- Loading bar -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/splash_progress_drawable" />

    </LinearLayout>

</FrameLayout>
