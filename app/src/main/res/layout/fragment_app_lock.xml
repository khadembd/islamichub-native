<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_app_lock.xml — biometric app lock screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_qibla"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_3xl">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/cd_app_logo"
        android:src="@drawable/ic_lock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/app_lock_prompt"
        android:textAppearance="@style/TextAppearance.IslamicHub.Headline"
        android:textSize="@dimen/text_h2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/app_lock_subtitle"
        android:textAppearance="@style/TextAppearance.IslamicHub.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlockButton"
        style="@style/Widget.IslamicHub.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:text="আনলক করুন"
        app:icon="@drawable/ic_lock"
        app:iconTint="@color/on_primary" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:textColor="@color/status_error"
        android:textSize="@dimen/text_body_sm" />

</LinearLayout>
