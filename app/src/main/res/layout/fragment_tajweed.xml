<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_tajweed.xml — recitation recorder with reference ayah -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_tajweed"
    android:gravity="center_horizontal"
    android:padding="@dimen/spacing_xl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:text="@string/tajweed_title"
        android:textAppearance="@style/TextAppearance.IslamicHub.Display"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_h1" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.IslamicHub.Card.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="তেলাওয়াত করুন"
                android:textAppearance="@style/TextAppearance.IslamicHub.Subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/referenceAyah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="@style/TextAppearance.IslamicHub.Arabic" />

            <TextView
                android:id="@+id/referenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="প্রস্তুত"
        android:textAppearance="@style/TextAppearance.IslamicHub.BodyLarge" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recordButton"
        style="@style/Widget.IslamicHub.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/tajweed_record"
        app:icon="@drawable/ic_mic"
        app:iconTint="@color/on_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playbackButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:enabled="false"
        android:text="প্লে করুন"
        app:icon="@drawable/ic_play" />

</LinearLayout>
