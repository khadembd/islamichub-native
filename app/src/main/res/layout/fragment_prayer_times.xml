<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_prayer_times.xml — five daily prayer times + location selector
    নামাজের সময়: ৫ ওয়াক্ত + লোকেশন
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Location card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IslamicHub.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="অবস্থান"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/locationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_on_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="ঢাকা, বাংলাদেশ" />

                <TextView
                    android:id="@+id/coordinatesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp"
                    tools:text="23.81°N, 90.41°E" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prayer list -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="আজকের নামাজের সময়"
            android:textAppearance="@style/TextAppearance.IslamicHub.Title" />

        <LinearLayout
            android:id="@+id/prayerListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Reminder toggle -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IslamicHub.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="নোটিফিকেশন রিমাইন্ডার"
                    android:textAppearance="@style/TextAppearance.IslamicHub.Title" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/notificationsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="নামাজের সময়ে রিমাইন্ডার দিন" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
