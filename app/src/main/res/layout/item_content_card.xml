<?xml version="1.0" encoding="utf-8"?>
<!-- item_content_card.xml — reusable card layout for all feature lists -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.IslamicHub.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.IslamicHub.Title"
            tools:text="সূরা আল-ফাতিহা" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.IslamicHub.Body"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="৭ আয়াত • মক্কী" />

        <TextView
            android:id="@+id/cardArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.IslamicHub.Arabic"
            android:visibility="gone"
            tools:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" />

        <TextView
            android:id="@+id/cardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.IslamicHub.Bengali"
            android:visibility="gone"
            tools:text="পরম করুণাময় অসীম দয়ালু আল্লাহর নামে..." />

        <TextView
            android:id="@+id/cardReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.IslamicHub.Body"
            android:textColor="@color/gold_dark"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="সহীহ বুখারী: ৬৩২৩" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
