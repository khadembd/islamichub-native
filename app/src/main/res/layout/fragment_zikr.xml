<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_zikr.xml — premium zikr/tasbih counter
    Per source zikr-counter.js + islamic.html zikr view:
    - Premium background image (zikr-premium-bg)
    - 6 zikr type selector (chips, not toggle)
    - Large circular tap target with gradient
    - Arabic + meaning + transliteration
    - Sets done + daily + grand total stats
    - Sound + haptic toggles
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_premium_zikr"
    android:padding="@dimen/spacing_xl">

    <!-- Zikr type selector — horizontal scrolling chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/zikrChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:chipSpacingHorizontal="@dimen/spacing_xs">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSubhanallah"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="সুবহানআল্লাহ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAlhamdulillah"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আলহামদুলিল্লাহ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllahuAkbar"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আল্লাহু আকবার" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLaIlaha"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="লা ইলাহা" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAstaghfirullah"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আস্তাগফিরুল্লাহ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDarood"
                style="@style/Widget.IslamicHub.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="দরূদ শরীফ" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Zikr name + meaning -->
    <TextView
        android:id="@+id/zikrTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="সুবহানআল্লাহ"
        android:textAppearance="@style/TextAppearance.IslamicHub.Headline"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_h2" />

    <TextView
        android:id="@+id/zikrArabic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/arabic_font"
        android:text="سُبْحَانَ اللَّهِ"
        android:textColor="@color/gold_light"
        android:textSize="@dimen/text_arabic_xl" />

    <TextView
        android:id="@+id/zikrMeaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="আল্লাহ পবিত্র"
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/text_body" />

    <!-- Big circular tap target -->
    <FrameLayout
        android:id="@+id/tapTarget"
        android:layout_width="@dimen/zikr_circle_size"
        android:layout_height="@dimen/zikr_circle_size"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:background="@drawable/bg_zikr_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/zikrCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="০"
                android:textColor="@android:color/white"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="ট্যাপ করুন"
                android:textColor="@color/gold_light"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/zikrTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="লক্ষ্য: ৩৩"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </FrameLayout>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/targetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৩৩"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_h1"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="লক্ষ্য"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/dailyTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="০"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_h1"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজ"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/grandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="০"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_h1"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মোট"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

    </LinearLayout>

    <!-- Reset / vibrate toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="রিসেট"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/vibrateSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="ভাইব্রেট"
            android:textColor="@android:color/white" />

    </LinearLayout>

</LinearLayout>
