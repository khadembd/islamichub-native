<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_zikr.xml — Zikr / Tasbih counter
    জিকির কাউন্টার: tap-to-count + target + total
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="?android:colorBackground">

    <TextView
        android:id="@+id/zikrTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="সুবহানাল্লাহ"
        android:textAppearance="@style/TextAppearance.IslamicHub.Headline" />

    <TextView
        android:id="@+id/zikrArabic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="سُبْحَانَ اللَّهِ"
        android:textAppearance="@style/TextAppearance.IslamicHub.Arabic" />

    <!-- Big circular tap target -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tapTarget"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/emerald_primary"
        app:cardCornerRadius="120dp"
        app:cardElevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/zikrCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_on_primary"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ট্যাপ করুন"
                android:textColor="@color/gold_light"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView android:id="@+id/targetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33"
                android:textColor="@color/emerald_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="লক্ষ্য"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView android:id="@+id/dailyTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/emerald_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView android:id="@+id/grandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/emerald_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মোট"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Reset / change zikr -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="রিসেট" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/changeZikrButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="জিকির পরিবর্তন" />

    </LinearLayout>

</LinearLayout>
