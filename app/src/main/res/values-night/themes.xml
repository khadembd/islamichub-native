<?xml version="1.0" encoding="utf-8"?>
<!--
    Islamic Hub — Dark theme color overrides
    Per UI/UX plan §11: proper token system for dark mode.
    Deep violet-black backgrounds, lavender primary, gold accents preserved.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IslamicHub" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/gold_light</item>
        <item name="colorSecondaryVariant">@color/gold</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnBackground">@color/text_on_primary_dark</item>
        <item name="colorOnSurface">@color/text_on_primary_dark</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="bottomNavigationStyle">@style/Widget.IslamicHub.BottomNavigationView.Dark</item>
    </style>

    <style name="Widget.IslamicHub.BottomNavigationView.Dark" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/gold_light</item>
        <item name="itemTextColor">@color/gold_light</item>
        <item name="backgroundTint">@color/dark_surface</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
