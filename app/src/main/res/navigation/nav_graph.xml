<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_graph.xml — per Master Plan §22-23:
    Bottom nav: Home, Daily, Amal, Qada, Settings
    Amal contains: Quran, Hadith, Dua, Namaz, Zikr, Qibla, Stories, etc.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home_dest">

    <!-- ============ Bottom nav top-level destinations (5) ============ -->

    <fragment
        android:id="@+id/home_dest"
        android:name="com.islamichub.feature.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_quran" app:destination="@id/quran_dest" />
        <action android:id="@+id/action_home_to_hadith" app:destination="@id/hadith_dest" />
        <action android:id="@+id/action_home_to_dua" app:destination="@id/dua_dest" />
        <action android:id="@+id/action_home_to_zikr" app:destination="@id/zikr_dest" />
        <action android:id="@+id/action_home_to_asmaul_husna" app:destination="@id/asmaul_husna_dest" />
        <action android:id="@+id/action_home_to_qibla" app:destination="@id/qibla_dest" />
        <action android:id="@+id/action_home_to_namaz" app:destination="@id/namaz_dest" />
        <action android:id="@+id/action_home_to_stories" app:destination="@id/stories_dest" />
        <action android:id="@+id/action_home_to_misconceptions" app:destination="@id/misconceptions_dest" />
        <action android:id="@+id/action_home_to_questions" app:destination="@id/questions_dest" />
        <action android:id="@+id/action_home_to_bookmarks" app:destination="@id/bookmarks_dest" />
        <action android:id="@+id/action_home_to_search" app:destination="@id/search_dest" />
        <action android:id="@+id/action_home_to_audio" app:destination="@id/audio_dest" />
        <action android:id="@+id/action_home_to_salah_tracker" app:destination="@id/salah_tracker_dest" />
        <action android:id="@+id/action_home_to_ai" app:destination="@id/ai_scholar_dest" />
        <action android:id="@+id/action_home_to_scanner" app:destination="@id/scanner_dest" />
        <action android:id="@+id/action_home_to_tajweed" app:destination="@id/tajweed_dest" />
        <action android:id="@+id/action_home_to_daily" app:destination="@id/daily_content_dest" />
        <action android:id="@+id/action_home_to_admin" app:destination="@id/admin_dest" />
        <action android:id="@+id/action_home_to_app_lock" app:destination="@id/app_lock_dest" />
        <action android:id="@+id/action_home_to_quran_reader" app:destination="@id/quran_reader_dest" />
        <action android:id="@+id/action_home_to_hadith_api" app:destination="@id/hadith_api_dest" />
        <action android:id="@+id/action_home_to_reading_tracker" app:destination="@id/reading_tracker_dest" />
        <action android:id="@+id/action_home_to_hijri" app:destination="@id/hijri_dest" />
        <action android:id="@+id/action_home_to_profile" app:destination="@id/profile_dest" />
    </fragment>

    <!-- Daily = Prayer Times timeline -->
    <fragment
        android:id="@+id/daily_dest"
        android:name="com.islamichub.feature.prayer.PrayerTimesFragment"
        android:label="@string/nav_daily"
        tools:layout="@layout/fragment_prayer_times" />

    <!-- Amal = All features grid (was MoreFragment) -->
    <fragment
        android:id="@+id/amal_dest"
        android:name="com.islamichub.feature.home.MoreFragment"
        android:label="@string/nav_amal"
        tools:layout="@layout/fragment_more" />

    <!-- Qada = Salah Tracker (missed prayers) -->
    <fragment
        android:id="@+id/qada_dest"
        android:name="com.islamichub.feature.tracker.SalahTrackerFragment"
        android:label="@string/nav_qada"
        tools:layout="@layout/fragment_salah_tracker" />

    <!-- Settings -->
    <fragment
        android:id="@+id/settings_dest"
        android:name="com.islamichub.feature.profile.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <!-- ============ Feature destinations ============ -->

    <fragment android:id="@+id/quran_dest" android:name="com.islamichub.feature.quran.QuranFragment" android:label="@string/section_quran" tools:layout="@layout/fragment_quran" />
    <fragment android:id="@+id/hadith_dest" android:name="com.islamichub.feature.hadith.HadithFragment" android:label="@string/section_hadith" tools:layout="@layout/fragment_hadith" />
    <fragment android:id="@+id/dua_dest" android:name="com.islamichub.feature.dua.DuaFragment" android:label="@string/section_dua" tools:layout="@layout/fragment_dua" />
    <fragment android:id="@+id/zikr_dest" android:name="com.islamichub.feature.zikr.ZikrFragment" android:label="@string/section_zikr" tools:layout="@layout/fragment_zikr" />
    <fragment android:id="@+id/asmaul_husna_dest" android:name="com.islamichub.feature.asmaulhusna.AsmaulHusnaFragment" android:label="@string/section_asmaul_husna" tools:layout="@layout/fragment_asmaul_husna" />
    <fragment android:id="@+id/qibla_dest" android:name="com.islamichub.feature.qibla.QiblaFragment" android:label="@string/section_qibla" tools:layout="@layout/fragment_qibla" />
    <fragment android:id="@+id/namaz_dest" android:name="com.islamichub.feature.namaz.NamazFragment" android:label="@string/section_namaz" tools:layout="@layout/fragment_namaz" />
    <fragment android:id="@+id/stories_dest" android:name="com.islamichub.feature.stories.StoriesFragment" android:label="@string/section_stories" tools:layout="@layout/fragment_stories" />
    <fragment android:id="@+id/misconceptions_dest" android:name="com.islamichub.feature.misconceptions.MisconceptionsFragment" android:label="@string/section_misconceptions" tools:layout="@layout/fragment_misconceptions" />
    <fragment android:id="@+id/questions_dest" android:name="com.islamichub.feature.questions.QuestionsFragment" android:label="@string/section_questions" tools:layout="@layout/fragment_questions" />
    <fragment android:id="@+id/bookmarks_dest" android:name="com.islamichub.feature.bookmarks.BookmarksFragment" android:label="@string/section_bookmarks" tools:layout="@layout/fragment_bookmarks" />
    <fragment android:id="@+id/search_dest" android:name="com.islamichub.feature.search.SearchFragment" android:label="@string/action_search" tools:layout="@layout/fragment_search" />

    <!-- New feature destinations -->
    <fragment android:id="@+id/audio_dest" android:name="com.islamichub.feature.audio.AudioFragment" android:label="নামাজ অডিও" tools:layout="@layout/fragment_generic_list" />
    <fragment android:id="@+id/salah_tracker_dest" android:name="com.islamichub.feature.tracker.SalahTrackerFragment" android:label="@string/salah_tracker_title" tools:layout="@layout/fragment_salah_tracker" />
    <fragment android:id="@+id/ai_scholar_dest" android:name="com.islamichub.feature.ai.AIScholarFragment" android:label="@string/ai_scholar_title" tools:layout="@layout/fragment_ai_scholar" />
    <fragment android:id="@+id/scanner_dest" android:name="com.islamichub.feature.scanner.VisionScannerFragment" android:label="@string/scanner_title" tools:layout="@layout/fragment_scanner" />
    <fragment android:id="@+id/tajweed_dest" android:name="com.islamichub.feature.tajweed.TajweedCheckerFragment" android:label="@string/tajweed_title" tools:layout="@layout/fragment_tajweed" />
    <fragment android:id="@+id/daily_content_dest" android:name="com.islamichub.feature.dailycontent.DailyContentFragment" android:label="দৈনিক বিষয়বস্তু" tools:layout="@layout/fragment_daily_content" />
    <fragment android:id="@+id/admin_dest" android:name="com.islamichub.feature.admin.AdminFragment" android:label="@string/admin_title" tools:layout="@layout/fragment_generic_list" />
    <fragment android:id="@+id/app_lock_dest" android:name="com.islamichub.feature.applock.AppLockFragment" android:label="@string/app_lock_title" tools:layout="@layout/fragment_app_lock" />
    <fragment android:id="@+id/quran_reader_dest" android:name="com.islamichub.feature.quran.QuranReaderFragment" android:label="কুরআন পাঠ" tools:layout="@layout/fragment_quran_reader" />
    <fragment android:id="@+id/hadith_api_dest" android:name="com.islamichub.feature.hadith.HadithApiFragment" android:label="হাদিস সংগ্রহ" tools:layout="@layout/fragment_generic_list" />
    <fragment android:id="@+id/reading_tracker_dest" android:name="com.islamichub.feature.tracker.ReadingTrackerFragment" android:label="পড়া ট্র্যাকার" tools:layout="@layout/fragment_reading_tracker" />
    <fragment android:id="@+id/hijri_dest" android:name="com.islamichub.feature.home.HijriDateFragment" android:label="হিজরি তারিখ" tools:layout="@layout/fragment_hijri_date" />
    <fragment android:id="@+id/profile_dest" android:name="com.islamichub.feature.profile.ProfileFragment" android:label="প্রোফাইল" tools:layout="@layout/fragment_profile" />

</navigation>
