<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_graph.xml — application navigation graph
    প্রতিটি গন্তব্য একটি Fragment। শুধুমাত্র native fragments — কোনো WebView নয়।
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home_dest">

    <!-- ============ Bottom nav top-level destinations ============ -->

    <fragment
        android:id="@+id/home_dest"
        android:name="com.islamichub.feature.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_quran" app:destination="@id/quran_dest" />
        <action android:id="@+id/action_home_to_hadith" app:destination="@id/hadith_dest" />
        <action android:id="@+id/action_home_to_dua" app:destination="@id/dua_dest" />
        <action android:id="@+id/action_home_to_zikr" app:destination="@id/zikr_dest" />
        <action android:id="@+id/action_home_to_asmaul_husna" app:destination="@id/asmaul_husna_dest" />
        <action android:id="@+id/action_home_to_qibla" app:destination="@id/qibla_dest" />
        <action android:id="@+id/action_home_to_namaz" app:destination="@id/namaz_dest" />
        <action android:id="@+id/action_home_to_stories" app:destination="@id/stories_dest" />
        <action android:id="@+id/action_home_to_misconceptions" app:destination="@id/misconceptions_dest" />
        <action android:id="@+id/action_home_to_questions" app:destination="@id/questions_dest" />
        <action android:id="@+id/action_home_to_bookmarks" app:destination="@id/bookmarks_dest" />
        <action android:id="@+id/action_home_to_search" app:destination="@id/search_dest" />
    </fragment>

    <fragment
        android:id="@+id/quran_dest"
        android:name="com.islamichub.feature.quran.QuranFragment"
        android:label="@string/section_quran"
        tools:layout="@layout/fragment_quran" />

    <fragment
        android:id="@+id/prayer_dest"
        android:name="com.islamichub.feature.prayer.PrayerTimesFragment"
        android:label="@string/section_qibla"
        tools:layout="@layout/fragment_prayer_times" />

    <fragment
        android:id="@+id/more_dest"
        android:name="com.islamichub.feature.home.MoreFragment"
        android:label="@string/nav_more"
        tools:layout="@layout/fragment_more" />

    <!-- ============ Feature destinations ============ -->

    <fragment
        android:id="@+id/hadith_dest"
        android:name="com.islamichub.feature.hadith.HadithFragment"
        android:label="@string/section_hadith"
        tools:layout="@layout/fragment_hadith" />

    <fragment
        android:id="@+id/dua_dest"
        android:name="com.islamichub.feature.dua.DuaFragment"
        android:label="@string/section_dua"
        tools:layout="@layout/fragment_dua" />

    <fragment
        android:id="@+id/zikr_dest"
        android:name="com.islamichub.feature.zikr.ZikrFragment"
        android:label="@string/section_zikr"
        tools:layout="@layout/fragment_zikr" />

    <fragment
        android:id="@+id/asmaul_husna_dest"
        android:name="com.islamichub.feature.asmaulhusna.AsmaulHusnaFragment"
        android:label="@string/section_asmaul_husna"
        tools:layout="@layout/fragment_asmaul_husna" />

    <fragment
        android:id="@+id/qibla_dest"
        android:name="com.islamichub.feature.qibla.QiblaFragment"
        android:label="@string/section_qibla"
        tools:layout="@layout/fragment_qibla" />

    <fragment
        android:id="@+id/namaz_dest"
        android:name="com.islamichub.feature.namaz.NamazFragment"
        android:label="@string/section_namaz"
        tools:layout="@layout/fragment_namaz" />

    <fragment
        android:id="@+id/stories_dest"
        android:name="com.islamichub.feature.stories.StoriesFragment"
        android:label="@string/section_stories"
        tools:layout="@layout/fragment_stories" />

    <fragment
        android:id="@+id/misconceptions_dest"
        android:name="com.islamichub.feature.misconceptions.MisconceptionsFragment"
        android:label="@string/section_misconceptions"
        tools:layout="@layout/fragment_misconceptions" />

    <fragment
        android:id="@+id/questions_dest"
        android:name="com.islamichub.feature.questions.QuestionsFragment"
        android:label="@string/section_questions"
        tools:layout="@layout/fragment_questions" />

    <fragment
        android:id="@+id/bookmarks_dest"
        android:name="com.islamichub.feature.bookmarks.BookmarksFragment"
        android:label="@string/section_bookmarks"
        tools:layout="@layout/fragment_bookmarks" />

    <fragment
        android:id="@+id/search_dest"
        android:name="com.islamichub.feature.search.SearchFragment"
        android:label="@string/action_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/settings_dest"
        android:name="com.islamichub.feature.profile.SettingsFragment"
        android:label="@string/section_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
