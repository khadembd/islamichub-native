# .gitignore
# Islamic Hub Native Android

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json IS committed in this repo so that CI can build
# a Firebase-enabled APK. The Firebase API key inside is safe to expose
# (Firebase API keys are restricted by package_name + SHA-1 in the
# Firebase console, not by secrecy).

# Mac
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.war
*.ear
*.zip
*.tar.gz
*.rar
# NOTE: *.jar is NOT ignored — the Gradle wrapper jar must be committed.
# Individual unwanted jars can still be excluded via more specific patterns.

# virtual machine crash logs
hs_err_pid*

# Worklog from sandbox
worklog.md
